@model IEnumerable<CarRentalSystem.Models.DamageReport>
@{
    ViewData["Title"] = "Lista Szkód";
}
<h1>Index - Zarządzanie Szkodami</h1>
<div class="row mb-3">
    <div class="col-md-6">
        <p>
            <a asp-action="Create" class="btn btn-success">Dodaj nową szkodę</a>
        </p>
    </div>
    @* --- TUTAJ DODAJEMY FORMULARZ WYSZUKIWANIA --- *@
    <div class="col-md-6 text-right">
        <form asp-action="Index" method="get" class="form-inline float-right">
            <div class="input-group">
                <input type="text" name="searchString" class="form-control"
                       placeholder="Szukaj w opisie..." />
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary">Filtruj</button>
                </div>
            </div>
        </form>
    </div>
</div>
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.ReportDate)</th>
            <th>@Html.DisplayNameFor(model => model.Car)</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@Html.DisplayFor(modelItem => item.ReportDate)</td>
                <td>@Html.DisplayFor(modelItem => item.Car.Brand) </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-
info">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm
btn-
warning">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm
btn-
danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>